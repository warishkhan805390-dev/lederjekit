# GEMINI_API_KEY: Optional server-side key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key used to sign customer authentication sessions.
JWT_SECRET="replace_with_secure_jwt_secret_in_production"

# STRIPE_SECRET_KEY: Optional Stripe secret key for online card payments.
# When omitted, Online Card Payment shows a transparent configuration notice and customers can complete orders via Cash on Delivery / Concierge Invoice.
STRIPE_SECRET_KEY=""

# STORE_WHATSAPP_NUMBER: International number (digits only) for the floating WhatsApp concierge button.
VITE_STORE_WHATSAPP="18005550194"

# STORE_PHONE_NUMBER: Customer concierge phone number for the left-side call button.
VITE_STORE_PHONE="+18005550194"
